# Application Settings
APP_NAME=AI Factory Safety Copilot API
API_VERSION=v1
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Security Configuration
SECRET_KEY=your-super-secret-random-string-for-jwt-signing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (Production requires MongoDB Atlas URL)
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=factory_safety

# AI Configuration (Priya's Gemini API Link)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# CORS Configuration (Allowed origins separated by comma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://ai-factory-safety-copilots.vercel.app
